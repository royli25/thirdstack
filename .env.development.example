# Copy to .env.development.local; fill only with a separate development project's settings.
# npm run dev never reads .env. Do not copy production credentials here.
STORAGE_BACKEND=postgres
DEVELOPMENT_SUPABASE_PROJECT_REF=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# UUIDs of accounts created in this development Auth project only.
SUPABASE_ADMIN_USER_IDS=
HOST=127.0.0.1
PORT=3009
PUBLIC_APP_URL=http://127.0.0.1:5175

# Development starts with empty history. Do not import production or fixture records.
# Required fallback namespace: generate a fresh UUID with node -p 'crypto.randomUUID()'.
# This does not import history or grant access; never copy the production workspace ID.
LEGACY_WORKSPACE_ID=
LEGACY_OWNER_USER_ID=
# Missing provider keys leave providers unavailable. Keep all keys server-side.
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
FIRECRAWL_ALLOW_KEYLESS=false
# Zero prevents positive-estimate calls until deliberately configured for development.
AGENT_SESSION_BUDGET_MICROS=0
PROVIDER_TEST_BUDGET_MICROS=0
PROVIDER_TEST_DAILY_BUDGET_MICROS=0
STRIPE_TEST_ENABLED=false
DEPOSITS_TESTNET_ENABLED=false
TWO_HANDS_SHADOW_WALLET=false
TWO_HANDS_SHADOW_STRIPE_SANDBOX=false
# Optional independent key for development connector tokens (32 bytes, hex or base64).
CONNECTOR_SECRET_KEY=
CONNECTOR_ALLOW_LOOPBACK=false

# Optional manual development MCP bridge; never use a production scoped key.
APILAYER_API_KEY=

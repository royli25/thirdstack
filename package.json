{
  "name": "apilayer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Observe agent intent, explicit tool choices, evidence, and evaluated outcomes over MCP",
  "scripts": {
    "dev": "node scripts/development.mjs",
    "dev:sqlite": "node scripts/development.mjs sqlite",
    "preview:production": "node scripts/development.mjs preview",
    "demo:dashboard": "vite --config prototypes/dashboard/vite.config.ts",
    "build": "tsc --noEmit && vite build && node scripts/compress-assets.mjs && tsc -p tsconfig.server.json && node scripts/build-release-manifest.mjs",
    "start": "node --use-env-proxy --env-file-if-exists=.env build/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "retention": "node --use-env-proxy --env-file-if-exists=.env build/retention.js",
    "format": "prettier --write server src tests scripts *.ts *.json *.html docs README.md AGENTS.md",
    "format:check": "prettier --check server src tests scripts *.ts *.json *.html docs README.md AGENTS.md",
    "smoke:live": "node --use-env-proxy --env-file-if-exists=.env build/live-validation.js",
    "mcp": "node --env-file-if-exists=.env build/mcp-stdio.js",
    "mcp:install": "node scripts/install-mcp.mjs",
    "test:soak": "node --import tsx scripts/soak-observation.ts",
    "test:soak:providers": "node --import tsx scripts/soak-provider-lab.ts",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "db:inspect": "node --use-env-proxy --env-file-if-exists=.env build/database-cli.js inspect",
    "db:migrate": "node --use-env-proxy --env-file-if-exists=.env build/database-cli.js migrate",
    "db:migrate:dev": "node scripts/development.mjs migrate",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "db:import": "node --use-env-proxy --env-file-if-exists=.env build/database-cli.js import",
    "db:verify": "node --use-env-proxy --env-file-if-exists=.env build/database-cli.js verify",
    "verify:release": "node scripts/verify-release-artifact.mjs",
    "db:backup": "node --use-env-proxy build/backup-cli.js backup",
    "db:restore": "node --use-env-proxy build/backup-cli.js restore",
    "test:restore": "node --import tsx scripts/restore-drill.ts",
    "simulate:sellers": "node --import tsx scripts/simulate-seller-data.ts",
    "connector:test-server": "node --import tsx scripts/test-mcp-server.ts",
    "connector:demo": "node --import tsx scripts/connector-demo.ts",
    "oauth:setup:dev": "node --use-env-proxy scripts/configure-mcp-oauth.mjs",
    "smoke:oauth:dev": "node --use-env-proxy scripts/verify-mcp-oauth.mjs"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@untitledui/icons": "^0.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "agentation": "^3.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

# Copy to the ignored .env.runtime file and replace every placeholder.
# Inject private values through the host's secret store for an actual deployment.
STORAGE_BACKEND=postgres
DATABASE_URL=
LEGACY_WORKSPACE_ID=replace-with-the-imported-workspace-uuid
SUPABASE_URL=https://replace.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_ADMIN_USER_IDS=replace-with-the-approved-admin-user-uuid

# Provider keys stay on the server. Missing keys leave that integration unavailable.
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Payment activation is outside this release.
DEPOSITS_TESTNET_ENABLED=false
STRIPE_TEST_ENABLED=false

# Optional public CA file mounted read-only at a path inside the container:
# NODE_EXTRA_CA_CERTS=/run/certs/provider-root.pem
# For recovery tooling against remote PostgreSQL, also configure PGSSLROOTCERT.
